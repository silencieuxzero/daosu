---
// ============================================================
// 密码转盘锁：每格一个字符环（▲/▼/点击字符切换），拨出正确组合开锁
// - lockId: 锁标识（用于 daosu:puzzle-update 事件）
// - dials: 每格的字符环（string[][]，长度 = 位数）
// - solution: 正确答案（与 dials 等长）
// 开锁后派发 daosu:puzzle-update { kind:'lock', id, solved:1, total:1 }，
// 由页面决定解锁内容与进度持久化
// ============================================================
const { lockId, dials, solution, hintText } = Astro.props as {
	lockId: string;
	dials: string[][];
	solution: string[];
	hintText?: string;
};

const width = dials.length;
---

<section
	class="dial"
	data-dial-lock
	data-lock-id={lockId}
	data-dials={JSON.stringify(dials)}
	data-solution={JSON.stringify(solution)}
	data-hint-text={hintText ?? ''}
	aria-label="密码转盘锁"
>
	<div class="dial__row">
		{
			dials.map((_, i) => (
				<div class="dial__unit" data-dial={i}>
					<button class="dial__arrow" data-role="up" type="button" aria-label={`第 ${i + 1} 位：上一个`}>▲</button>
					<div class="dial__char" data-role="char" aria-live="polite">？</div>
					<button class="dial__arrow" data-role="down" type="button" aria-label={`第 ${i + 1} 位：下一个`}>▼</button>
				</div>
			))
		}
	</div>
	<div class="dial__actions">
		<button class="dial__submit" data-role="submit" type="button">开锁</button>
		<button class="dial__hint" data-role="hint" type="button">提示</button>
		<button class="dial__shuffle" data-role="shuffle" type="button">打乱</button>
	</div>
	<p class="dial__feedback" data-role="feedback" role="status"></p>
	<p class="dial__meta">共 {width} 位 · 每位转盘拨到正确位置</p>
</section>

<style>
	.dial {
		border: var(--line) solid var(--border);
		padding: 18px 20px 20px;
	}

	.dial__row {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
	}

	.dial__unit {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4px;
		min-width: 64px;
		padding: 8px 6px;
		border: var(--line) solid var(--border);
		background: var(--bg);
		transition: border-color 0.15s ease;
	}

	.dial__char {
		font-size: 30px;
		font-weight: 900;
		line-height: 1.5;
		cursor: pointer;
		user-select: none;
		-webkit-user-select: none;
		transition: color 0.15s ease;
	}

	.dial__char:hover {
		color: var(--accent);
	}

	.dial__arrow {
		width: 100%;
		padding: 3px 0;
		background: transparent;
		border: none;
		border-radius: 0;
		font: 700 10px/1 var(--font-mono);
		color: var(--fg-muted);
		cursor: pointer;
		transition: color 0.15s ease;
	}

	.dial__arrow:hover {
		color: var(--accent);
	}

	/* 开锁成功：字与框变强调色 */
	.dial.is-open .dial__char {
		color: var(--accent);
	}

	.dial.is-open .dial__unit {
		border-color: var(--accent);
	}

	/* 拨错：轻晃 */
	.dial.is-shake {
		animation: dial-shake 0.25s ease-in-out 2;
	}

	@keyframes dial-shake {
		0%, 100% { transform: none; }
		25% { transform: translateX(-6px); }
		75% { transform: translateX(6px); }
	}

	.dial__actions {
		margin-top: 14px;
		display: flex;
		gap: 8px;
		flex-wrap: wrap;
	}

	.dial__submit {
		padding: 11px 18px;
		background: var(--fg);
		color: var(--bg);
		border: var(--line) solid var(--border);
		border-radius: 0;
		font: 700 12px/1 var(--font-mono);
		letter-spacing: 0.14em;
		cursor: pointer;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.dial__submit:hover {
		background: var(--accent);
		color: var(--bg);
		border-color: var(--accent);
	}

	.dial__hint,
	.dial__shuffle {
		padding: 11px 16px;
		background: transparent;
		color: var(--fg-muted);
		border: var(--line) solid var(--border);
		border-radius: 0;
		font: 700 12px/1 var(--font-mono);
		letter-spacing: 0.12em;
		cursor: pointer;
		transition: color 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
	}

	.dial__hint:hover,
	.dial__shuffle:hover {
		background: var(--fg);
		color: var(--bg);
		border-color: var(--border);
	}

	.dial__feedback {
		margin: 12px 0 0;
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.06em;
		color: var(--fg-muted);
		min-height: 1em;
	}

	.dial__feedback.is-error {
		color: var(--accent);
	}

	.dial__feedback.is-open {
		color: var(--accent);
	}

	.dial__meta {
		margin: 8px 0 0;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.1em;
		color: var(--fg-muted);
	}
</style>

<script>
	// 数据经 data-* 属性传入；按 [data-dial-lock] 遍历以支持同页多实例
	document.querySelectorAll<HTMLElement>('[data-dial-lock]').forEach((lock) => {
		const dialsData = JSON.parse(lock.dataset.dials ?? '[]') as string[][];
		const solution = JSON.parse(lock.dataset.solution ?? '[]') as string[];
		const lockId = lock.dataset.lockId ?? '';
		if (!Array.isArray(dialsData) || dialsData.length === 0) return;

		const units = Array.from(lock.querySelectorAll<HTMLElement>('.dial__unit'));
		const feedback = lock.querySelector<HTMLElement>('[data-role="feedback"]');
		const submit = lock.querySelector<HTMLElement>('[data-role="submit"]');
		const hintBtn = lock.querySelector<HTMLElement>('[data-role="hint"]');
		const shuffleBtn = lock.querySelector<HTMLElement>('[data-role="shuffle"]');

		// 每格当前字符在环中的下标
		const state = dialsData.map(() => 0);
		let open = false;

		const render = () => {
			units.forEach((u, i) => {
				const ch = u.querySelector('[data-role="char"]');
				if (ch) ch.textContent = dialsData[i][state[i]];
			});
		};

		const setPos = (i: number, delta: number) => {
			state[i] = (state[i] + delta + dialsData[i].length) % dialsData[i].length;
			render();
		};

		const shuffle = () => {
			state.forEach((_, i) => {
				state[i] = Math.floor(Math.random() * dialsData[i].length);
			});
			open = false;
			lock.classList.remove('is-open');
			render();
			if (feedback) {
				feedback.textContent = '';
				feedback.classList.remove('is-error', 'is-open');
			}
		};

		units.forEach((u, i) => {
			const up = u.querySelector('[data-role="up"]');
			const down = u.querySelector('[data-role="down"]');
			const ch = u.querySelector('[data-role="char"]');
			if (up) up.addEventListener('click', () => setPos(i, -1));
			if (down) down.addEventListener('click', () => setPos(i, 1));
			if (ch) ch.addEventListener('click', () => setPos(i, 1));
		});

		if (submit) {
			submit.addEventListener('click', () => {
				if (open) return;
				const combo = state.map((p, i) => dialsData[i][p]).join('');
				if (combo === solution.join('')) {
					open = true;
					lock.classList.add('is-open');
					if (feedback) {
						feedback.textContent = '咔哒。锁开了。';
						feedback.classList.remove('is-error');
						feedback.classList.add('is-open');
					}
					window.dispatchEvent(
						new CustomEvent('daosu:puzzle-update', {
							detail: { kind: 'lock', id: lockId, solved: 1, total: 1 },
						})
					);
				} else {
					if (feedback) {
						feedback.textContent = '锁纹丝不动。';
						feedback.classList.add('is-error');
						feedback.classList.remove('is-open');
					}
					lock.classList.remove('is-shake');
					void lock.offsetWidth;
					lock.classList.add('is-shake');
				}
			});
		}

		if (hintBtn) {
			hintBtn.addEventListener('click', () => {
				if (feedback) {
					feedback.textContent =
						lock.dataset.hintText || '口令是四个字：不忘凉茶。';
					feedback.classList.remove('is-error', 'is-open');
				}
			});
		}

		if (shuffleBtn) shuffleBtn.addEventListener('click', shuffle);

		shuffle();
	});
</script>

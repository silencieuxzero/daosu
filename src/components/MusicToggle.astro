---
// ============================================================
// 音乐播放器悬浮开关 · 平面主义风格
// 右下角方形按钮，点击展开播放器卡片；点击外部/关闭按钮收起
// ============================================================
import MusicPlayer from './MusicPlayer.astro';
---

<div class="music-toggle" id="music-toggle">
	<button
		class="music-toggle__btn"
		id="music-toggle-btn"
		type="button"
		aria-label="打开音乐播放器"
		aria-expanded="false"
	>
		<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" aria-hidden="true">
			<path d="M9 18V5l12-2v13" />
			<circle cx="6" cy="18" r="3" />
			<circle cx="18" cy="16" r="3" />
		</svg>
	</button>

	<div class="music-toggle__panel" id="music-toggle-panel">
		<button class="music-toggle__close" id="music-close-btn" type="button" aria-label="收起音乐播放器">
			<svg viewBox="0 0 16 16" width="10" height="10" aria-hidden="true"><path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="2" stroke-linecap="square"/></svg>
		</button>
		<MusicPlayer />
	</div>
</div>

<style>
	.music-toggle {
		position: fixed;
		right: 20px;
		bottom: 20px;
		z-index: 95;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
	}

	/* 方形悬浮按钮：accent 实心 + 2px 边框 */
	.music-toggle__btn {
		width: 52px;
		height: 52px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: var(--accent);
		color: var(--bg);
		border: var(--line) solid var(--border);
		border-radius: 0;
		cursor: pointer;
		box-shadow: 4px 4px 0 0 var(--fg);
		transition: background-color 0.15s ease, color 0.15s ease, box-shadow 0.15s ease;
	}

	.music-toggle__btn:hover {
		background: var(--fg);
		color: var(--bg);
		box-shadow: 2px 2px 0 0 var(--fg);
	}

	.music-toggle__btn.is-open {
		background: var(--fg);
		color: var(--bg);
	}

	/* 面板：bg 底 + 2px 边框 + 硬投影 */
	.music-toggle__panel {
		position: absolute;
		right: 0;
		bottom: 64px;
		width: 300px;
		background: var(--bg);
		border: var(--line) solid var(--border);
		box-shadow: 6px 6px 0 0 var(--fg);
		padding: 18px 18px 14px;
		opacity: 0;
		transform: translateY(8px);
		pointer-events: none;
		transition: opacity 0.18s ease, transform 0.18s ease;
	}

	.music-toggle.is-open .music-toggle__panel {
		opacity: 1;
		transform: translateY(0);
		pointer-events: auto;
	}

	/* 关闭按钮：右上角小方块 */
	.music-toggle__close {
		position: absolute;
		top: -1px;
		right: -1px;
		width: 28px;
		height: 28px;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		background: var(--fg);
		color: var(--bg);
		border: var(--line) solid var(--border);
		border-radius: 0;
		cursor: pointer;
		z-index: 3;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.music-toggle__close:hover {
		background: var(--accent);
		color: var(--bg);
		border-color: var(--accent);
	}

	/* 古代主题：面板微回纹底 */
	[data-theme='ancient'] .music-toggle__panel {
		background-image: var(--texture-rect);
		background-size: 56px 56px;
	}

	/* ===== 响应式 ===== */
	@media (max-width: 640px) {
		.music-toggle {
			right: 14px;
			bottom: 14px;
		}

		.music-toggle__btn {
			width: 48px;
			height: 48px;
		}

		.music-toggle__panel {
			width: min(300px, calc(100vw - 28px));
			right: 0;
			bottom: 60px;
		}
	}
</style>

<script define:vars={{ pt: { open: '打开音乐播放器', close: '收起音乐播放器' } }}>
	const wrapper = document.getElementById('music-toggle');
	const toggleBtn = document.getElementById('music-toggle-btn');
	const closeBtn = document.getElementById('music-close-btn');

	function setOpen(open) {
		wrapper.classList.toggle('is-open', open);
		toggleBtn.classList.toggle('is-open', open);
		toggleBtn.setAttribute('aria-expanded', String(open));
		// 无障碍标签随状态切换（打开/收起）
		toggleBtn.setAttribute('aria-label', open ? pt.close : pt.open);
	}

	toggleBtn.addEventListener('click', () => {
		setOpen(!wrapper.classList.contains('is-open'));
	});

	if (closeBtn) {
		closeBtn.addEventListener('click', () => setOpen(false));
	}

	// 点击外部区域收起
	document.addEventListener('click', (e) => {
		if (wrapper && !wrapper.contains(e.target)) {
			setOpen(false);
		}
	});

	// Escape 收起
	document.addEventListener('keydown', (e) => {
		if (e.key === 'Escape' && wrapper.classList.contains('is-open')) {
			setOpen(false);
			toggleBtn.focus();
		}
	});
</script>

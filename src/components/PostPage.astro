---
// 文章详情页（三语共用）
import { render } from 'astro:content';
import { ui, defaultLang } from '../i18n/ui';
import { formatDate, localizedPath, type Lang } from '../i18n/utils';
import { config } from '../lib/config';
import TableOfContents from './TableOfContents.astro';
import ReaderMode from './ReaderMode.astro';

const { post, locale = defaultLang } = Astro.props as {
	post: any;
	locale?: Lang;
};
const t = ui[locale] ?? ui[defaultLang];
const { Content } = await render(post);

// 作者信息（来自 config.mjs）
const authorName = config.profile.author || config.site.name;
const githubHref = config.profile.github.startsWith('http')
	? config.profile.github
	: `https://${config.profile.github}`;
---

<!-- ===== 阅读进度条（顶部 3px 指示） ===== -->
<div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

<main class="page">
	<article class="prose">
		<header class="post-head">
			<span class="seal" aria-hidden="true">篇</span>
			<p class="kicker">{formatDate(post.data.date, locale)}</p>
			<h1>{post.data.title}</h1>
			{
				post.data.description && (
					<p class="post-head__desc">{post.data.description}</p>
				)
			}
			<div class="post-head__tags">
				{
					post.data.tags.map((tag: string) => (
						<span class="post-head__tag">{tag}</span>
					))
				}
			</div>
		</header>
		<Content />
	</article>

	<!-- ===== 作者信息栏 ===== -->
	<aside class="author-box" aria-label="author">
		<div class="author-box__info">
			<p class="author-box__kicker">{t['post.author']}</p>
			<p class="author-box__name">{authorName}</p>
		</div>
		<div class="author-box__links">
			{
				config.profile.email && (
					<a class="btn btn--outline" href={`mailto:${config.profile.email}`}>
						Email
					</a>
				)
			}
			{
				config.profile.github && (
					<a class="btn btn--outline" href={githubHref} target="_blank" rel="noopener noreferrer">
						GitHub ↗
					</a>
				)
			}
		</div>
	</aside>

	<nav class="back" aria-label="post navigation">
		<a class="btn btn--outline" href={localizedPath('/', locale)}>
			{t['post.back']}
		</a>
	</nav>
</main>

<!-- ===== 文章工具：目录 / 阅读模式 ===== -->
<TableOfContents locale={locale} />
<ReaderMode locale={locale} />

<style>
	/* ===== 阅读进度条 ===== */
	.reading-progress {
		position: fixed;
		top: 0;
		left: 0;
		height: 3px;
		width: 0;
		background: var(--accent);
		z-index: 70;
		pointer-events: none;
	}

	.page {
		padding: clamp(40px, 6vh, 72px) clamp(16px, 4vw, 48px);
		max-width: 820px;
		margin: 0 auto;
	}

	/* 文章头部 */
	.post-head {
		position: relative;
		padding-bottom: 28px;
		margin-bottom: 36px;
		border-bottom: var(--line) solid var(--border);
		background-color: var(--bg);
		background-image: var(--texture-rect);
		background-size: 56px 56px;
	}

	.post-head h1 {
		margin: 16px 0 14px;
		font-size: clamp(28px, 4.5vw, 42px);
		font-weight: 900;
		line-height: 1.2;
		letter-spacing: -0.01em;
	}

	.post-head__desc {
		color: var(--fg-muted);
		line-height: 1.8;
		margin-bottom: 16px;
	}

	.post-head__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.post-head__tag {
		border: 1px solid var(--grid-line);
		padding: 4px 10px;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.12em;
		color: var(--fg-muted);
	}

	/* 铭文水印 */
	.post-head .seal {
		right: 0;
		top: -10px;
		font-size: clamp(90px, 16vw, 200px);
	}

	.post-head > *:not(.seal) {
		position: relative;
		z-index: 1;
	}

	/* ===== 作者信息栏 ===== */
	.author-box {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 16px;
		margin-top: 48px;
		padding: 22px 24px;
		border: var(--line) solid var(--border);
		background-color: var(--bg);
		background-image: var(--texture-rect);
		background-size: 56px 56px;
	}

	.author-box__kicker {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.18em;
		color: var(--fg-muted);
		margin-bottom: 6px;
	}

	.author-box__name {
		font-size: 22px;
		font-weight: 900;
		letter-spacing: 0.02em;
	}

	.author-box__links {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	/* 古代主题：器物式双线层叠 */
	[data-theme='ancient'] .author-box {
		outline: 2px solid var(--grid-line);
		outline-offset: 4px;
	}

	/* 返回链接 */
	.back {
		margin-top: 48px;
	}

	/* ===== 代码块折叠（动态元素，:global） ===== */
	:global(.code-fold) {
		margin: 1.4em 0;
		border: var(--line) solid var(--border);
		background: var(--bg-alt);
	}

	:global(.code-fold__head) {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 8px 12px;
		border-bottom: var(--line) solid var(--border);
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.1em;
	}

	:global(.code-fold__lang) {
		font-weight: 700;
		text-transform: uppercase;
	}

	:global(.code-fold__count) {
		flex: 1;
		color: var(--fg-muted);
	}

	:global(.code-fold__btn) {
		background: var(--bg);
		color: var(--fg);
		border: 1px solid var(--border);
		padding: 4px 10px;
		font: 700 11px/1 var(--font-mono);
		cursor: pointer;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	:global(.code-fold__btn:hover) {
		background: var(--fg);
		color: var(--bg);
	}

	:global(.code-fold pre) {
		margin: 0;
		border: none;
		background: none;
	}

	:global(.code-fold[data-expanded='false'] pre) {
		max-height: 170px;
		overflow: hidden;
	}
</style>

<script define:vars={{ pt: { expand: t['code.expand'], collapse: t['code.collapse'] } }}>
	// ============================================================
	// 阅读进度条：顶部 3px accent 条，随滚动填充
	// ============================================================
	const progress = document.getElementById('reading-progress');
	if (progress) {
		let ticking = false;
		const update = () => {
			const doc = document.documentElement;
			const max = doc.scrollHeight - doc.clientHeight;
			const pct = max > 0 ? (window.scrollY / max) * 100 : 0;
			progress.style.width = pct + '%';
			ticking = false;
		};
		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(update);
				}
			},
			{ passive: true }
		);
		update();
	}

	// ============================================================
	// 代码块折叠：包一层标题栏（语言 + 行数 + 按钮），>15 行默认折叠
	// ============================================================
	const FOLD_THRESHOLD = 15;
	const pros = document.querySelectorAll('.prose pre');

	pros.forEach((pre) => {
		const code = pre.querySelector('code');
		if (!code) return;

		// 语言：astro-code 类名中提取 language-xxx
		const langMatch = (pre.className || '').match(/language-([\w+]+)/);
		const lang = langMatch ? langMatch[1] : 'code';

		// 行数：Shiki .line 计数，回退换行统计
		const lineEls = code.querySelectorAll('.line');
		const textLines = pre.textContent.trim() ? pre.textContent.trim().split('\n') : [];
		const lines = lineEls.length || textLines.length;

		// 包 wrapper
		const wrapper = document.createElement('div');
		wrapper.className = 'code-fold';
		const collapsed = lines > FOLD_THRESHOLD;
		wrapper.dataset.expanded = String(!collapsed);

		const head = document.createElement('div');
		head.className = 'code-fold__head';

		const langEl = document.createElement('span');
		langEl.className = 'code-fold__lang';
		langEl.textContent = lang;

		const countEl = document.createElement('span');
		countEl.className = 'code-fold__count';
		countEl.textContent = `${lines} 行`;

		const btn = document.createElement('button');
		btn.type = 'button';
		btn.className = 'code-fold__btn';
		btn.dataset.expanded = String(!collapsed);
		btn.setAttribute('aria-expanded', String(!collapsed));
		btn.textContent = collapsed ? pt.expand : pt.collapse;
		btn.addEventListener('click', () => {
			const next = wrapper.dataset.expanded !== 'true';
			wrapper.dataset.expanded = String(next);
			btn.dataset.expanded = String(next);
			btn.setAttribute('aria-expanded', String(next));
			btn.textContent = next ? pt.collapse : pt.expand;
		});

		head.append(langEl, countEl, btn);
		pre.parentNode.insertBefore(wrapper, pre);
		wrapper.append(head, pre);
	});
</script>

---
// ============================================================
// 社交平台图标 · 线性几何风格 · currentColor
// icon 由 config.toml 配置（bilibili/github/email/rss/x/telegram/youtube/link）
// 未配置时按 href 自动识别（bilibili.com / github.com / mailto:），兜底 link
// ============================================================
const { label = '', href = '', icon } = Astro.props as {
	label?: string;
	href?: string;
	icon?: string;
};

const KNOWN = ['bilibili', 'github', 'email', 'link', 'rss', 'x', 'telegram', 'youtube'];

// 解析最终图标名：配置优先，否则按链接识别
let name = 'link';
if (icon && KNOWN.includes(icon)) {
	name = icon;
} else {
	const lower = (href || '').toLowerCase();
	if (lower.includes('bilibili.com')) name = 'bilibili';
	else if (lower.includes('github.com')) name = 'github';
	else if (lower.startsWith('mailto:')) name = 'email';
}
---

{
	name === 'bilibili' && (
		<svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<path d="M8 2.5 6.5 5.5M16 2.5l1.5 3" />
			<rect x="3" y="6.5" width="18" height="13" />
			<rect x="6.5" y="10.5" width="11" height="5.5" />
		</svg>
	)
}
{
	name === 'github' && (
		<svg class="social-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
			<path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36-3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.19 1.76 1.19 1.03 1.76 2.69 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.28-5.24-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11.1 11.1 0 0 1 5.78 0c2.21-1.49 3.18-1.18 3.18-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.7 5.38-5.26 5.66.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .31.21.67.8.56A11.52 11.52 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
		</svg>
	)
}
{
	name === 'email' && (
		<svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<rect x="2" y="4.5" width="20" height="15" />
			<path d="M2.5 6.5l9.5 7 9.5-7" />
		</svg>
	)
}
{
	name === 'rss' && (
		<svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<path d="M4 4c8.84 0 16 7.16 16 16" />
			<path d="M4 10.5C9.25 10.5 13.5 14.75 13.5 20" />
			<circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none" />
		</svg>
	)
}
{
	name === 'x' && (
		<svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<path d="M4 4l16 16M20 4L4 20" />
		</svg>
	)
}
{
	name === 'telegram' && (
		<svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<path d="m22 2-7 20-4-9-9-4Z" />
			<path d="M22 2 11 13" />
		</svg>
	)
}
{
	name === 'youtube' && (
		<svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<rect x="2" y="5" width="20" height="14" />
			<path d="M10 9.5v5l5-2.5z" fill="currentColor" stroke="none" />
		</svg>
	)
}
{
	name === 'link' && (
		<svg class="social-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
			<path d="M5 12h13M13 6l6 6-6 6" />
		</svg>
	)
}

<style>
	.social-icon {
		width: 13px;
		height: 13px;
		flex: none;
	}
</style>

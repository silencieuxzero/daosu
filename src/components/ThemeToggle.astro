---
// 主题切换按钮 · 平面主义风格 · 支持多语言
import type { Lang } from '../i18n/utils';

const labels: Record<Lang, { modern: string; ancient: string }> = {
	zh: { modern: '现代', ancient: '古代' },
	en: { modern: 'Modern', ancient: 'Ancient' },
	it: { modern: 'Moderno', ancient: 'Antico' },
};

const { locale = 'zh' } = Astro.props as { locale?: Lang };
const t = labels[locale] ?? labels.zh;
---

<button id="theme-toggle" class="theme-toggle" type="button" aria-label={t.modern}>
	<span class="theme-toggle__dot" aria-hidden="true"></span>
	<span id="theme-label" class="theme-toggle__label">{t.modern}</span>
	<span class="theme-toggle__arrow" aria-hidden="true">⇄</span>
</button>

<style>
	.theme-toggle {
		display: flex;
		align-items: center;
		gap: 10px;
		padding: 12px 16px;
		background: var(--bg);
		color: var(--fg);
		border: var(--line) solid var(--border);
		border-radius: 0;
		font: 700 13px/1 var(--font-sans);
		letter-spacing: 0.12em;
		cursor: pointer;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.theme-toggle:hover {
		background: var(--accent);
		color: var(--bg);
		border-color: var(--accent);
	}

	.theme-toggle__dot {
		width: 10px;
		height: 10px;
		background: var(--accent);
		border: 2px solid var(--border);
		border-radius: 0;
		transition: background-color 0.15s ease;
	}

	.theme-toggle:hover .theme-toggle__dot {
		background: var(--bg);
		border-color: var(--bg);
	}

	.theme-toggle__arrow {
		font-size: 14px;
		line-height: 1;
	}

	/* 小屏压缩按钮，避免顶栏过挤 */
	@media (max-width: 640px) {
		.theme-toggle {
			padding: 9px 11px;
		}

		.theme-toggle__arrow {
			display: none;
		}
	}
</style>

<script define:vars={{ t }}>
	const btn = document.getElementById('theme-toggle');
	const label = document.getElementById('theme-label');
	const footerTheme = document.getElementById('footer-theme');
	const KEY = 'daosu-theme';

	function apply(theme) {
		document.documentElement.setAttribute('data-theme', theme);
		const name = theme === 'ancient' ? t.ancient : t.modern;
		label.textContent = name;
		btn.setAttribute('aria-label', name);
		if (footerTheme) footerTheme.textContent = name;
		localStorage.setItem(KEY, theme);
	}

	btn.addEventListener('click', () => {
		const cur = document.documentElement.getAttribute('data-theme');
		apply(cur === 'ancient' ? 'modern' : 'ancient');
	});

	apply(document.documentElement.getAttribute('data-theme') || 'modern');
</script>

---
// ============================================================
// 导航栏时间线：顶栏按钮点击展开时间线卡片
// 页面级：当前页面配置了 timeline → 渲染该时间线（滑块驱动 era 正文 + 主题）
// 未配置 → 默认两节点「古代 / 现代」（纯主题切换）
// 数据由 Layout 按当前路径匹配后传入
// ============================================================
interface TimelineItem {
	era: number | string; // 'full' = 完整档案档
	label: string;
	title: string;
	theme?: string;
}

const { timeline = null, variant = 'desktop' } = Astro.props as {
	timeline?: TimelineItem[] | null;
	variant?: 'desktop' | 'mobile'; // mobile = 汉堡菜单内实例（移动端专用布局）
};
const isMobile = variant === 'mobile';

// 无页面时间线 → 默认两节点：古代（ancient）/ 现代（modern）
const DEFAULT_ITEMS: TimelineItem[] = [
	{ era: 0, label: '古代', title: '古代 · Ancient', theme: 'ancient' },
	{ era: 1, label: '现代', title: '现代 · Modern', theme: 'modern' },
];
const hasPageTimeline = timeline && timeline.length > 0;
// 页面时间线末尾追加“完整档案”档（对应 data-era-block=full；不改变主题）
const items: TimelineItem[] = hasPageTimeline
	? [...timeline, { era: 'full', label: '完整档案', title: '完整档案' }]
	: DEFAULT_ITEMS;
const last = items.length - 1;
---

<div class:list={['tl-nav', { 'tl-nav--mobile': isMobile }]}>
	<button
		id={isMobile ? 'tl-nav-toggle-m' : 'tl-nav-toggle'}
		class="tl-nav__toggle"
		type="button"
		aria-haspopup="true"
		aria-expanded="false"
	>
		<span>时间线</span>
		<span class="tl-nav__caret" aria-hidden="true">▾</span>
	</button>

	<div id={isMobile ? 'tl-nav-panel-m' : 'tl-nav-panel'} class="tl-nav__panel" hidden>
		<header class="tl-nav__head">
			<span class="tl-nav__kicker">时间线 · TIMELINE</span>
			<span class="tl-nav__hint">拖动滑块查看不同时期</span>
		</header>

		<div class="tl-nav__block">
			<input
				class="tl-nav__range"
				type="range"
				min="0"
				max={last}
				step="1"
				value={last}
				aria-label="时间线位置"
			/>
			<div class="tl-nav__marks">
				{items.map((it, i) => (
					<span
						class="tl-nav__mark"
						data-era={it.era}
						data-theme={it.theme}
						style={`left: calc(10px + (100% - 20px) * ${i} / ${last})`}
					>{it.label}</span>
				))}
			</div>
			<div class="tl-nav__scenes">
				{items.map((it) => (
					<div class="tl-nav__scene" data-scene={it.era}>
						<h4 class="tl-nav__title">{it.title}</h4>
					</div>
				))}
			</div>
		</div>
	</div>
</div>
<script define:vars={{ hasPageTimeline }}>
	// 主题名（footer 同步显示）
	const themeLabels = { modern: '现代', ancient: '古代' };

	// 桌面导航与移动端汉堡菜单各有一个 .tl-nav 实例，统一遍历初始化；
	// dataset 标记保证幂等（脚本可能被去重执行或重复打包）。
	document.querySelectorAll('.tl-nav').forEach((root) => {
		if (root.dataset.tlNavReady) return;
		root.dataset.tlNavReady = '1';

		const toggle = root.querySelector('.tl-nav__toggle');
		const panel = root.querySelector('.tl-nav__panel');
		const range = panel ? panel.querySelector('.tl-nav__range') : null;
		const marks = panel ? Array.from(panel.querySelectorAll('.tl-nav__mark')) : [];
		const scenes = panel ? Array.from(panel.querySelectorAll('.tl-nav__scene')) : [];

		if (toggle && panel) {
			toggle.addEventListener('click', (e) => {
				e.stopPropagation();
				panel.hidden = !panel.hidden;
				toggle.setAttribute('aria-expanded', String(!panel.hidden));
				if (!panel.hidden) fitPanelWidth();
			});

			// 捕获阶段：点击页面任意处先关闭本卡片
			document.addEventListener(
				'click',
				(e) => {
					if (
						!panel.hidden &&
						(!(e.target instanceof Node) || !panel.contains(e.target)) &&
						e.target !== toggle
					) {
						panel.hidden = true;
						toggle.setAttribute('aria-expanded', 'false');
					}
				},
				true
			);

			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape' && !panel.hidden) {
					panel.hidden = true;
					toggle.setAttribute('aria-expanded', 'false');
					toggle.focus();
				}
			});
		}

		// 场景显隐（索引匹配）
		function syncScenes() {
			if (!range) return;
			const v = Number(range.value);
			scenes.forEach((s, i) => s.classList.toggle('is-active', i === v));
			marks.forEach((m) => m.classList.toggle('is-active', Number(m.dataset.era) === v));
		}

		function syncFooterTheme(theme) {
			const el = document.getElementById('footer-theme');
			if (el) el.textContent = theme === 'ancient' ? themeLabels.ancient : themeLabels.modern;
		}

		function applyEra() {
			if (!range) return;
			const v = hasPageTimeline && Number(range.value) === Number(range.max) ? 'full' : String(range.value);
			const rootEl = document.documentElement;
			rootEl.setAttribute('data-era', v);
			const mark = marks.find((m) => String(m.dataset.era) === v);
			const theme = mark && mark.dataset.theme ? mark.dataset.theme : null;
			if (theme) {
				rootEl.setAttribute('data-theme', theme);
				syncFooterTheme(theme);
			}
		}

		// 首尾刻度与滑块按钮对齐：整体平移（半宽 - 10px）
		function fitPanelWidth() {
			if (!panel || panel.hidden || !range) return;
			let maxW = 0;
			marks.forEach((m) => { maxW = Math.max(maxW, m.offsetWidth); });
			const ml = Math.max(0, (marks[0] ? marks[0].offsetWidth : 0) / 2 - 10);
			const mr = Math.max(0, (marks.length ? marks[marks.length - 1].offsetWidth : 0) / 2 - 10);
			const marksEl = panel.querySelector('.tl-nav__marks');
			if (marksEl) {
				marksEl.style.marginLeft = ml + 'px';
				marksEl.style.marginRight = mr + 'px';
			}
			range.style.marginLeft = ml + 'px';
			range.style.marginRight = mr + 'px';
			range.style.width = 'calc(100% - ' + (ml + mr) + 'px)';
			// 移动端静态面板不设最小宽度，避免撑破窄屏
			if (maxW > 0 && root.classList.contains('tl-nav--mobile')) {
				panel.style.minWidth = '0';
			} else if (maxW > 0) {
				panel.style.minWidth = maxW + 44 + 'px';
			}
		}

		if (range) {
			range.addEventListener('input', () => {
				syncScenes();
				applyEra();
			});
		}

		// 初始化：停在最后一个节点（“现在”）
		if (range) {
			syncScenes();
			applyEra();
		}
		window.addEventListener('load', () => { if (panel && !panel.hidden) fitPanelWidth(); });
	});
</script>
<style>
	/* ===== 导航栏时间线：按钮 ===== */
	.tl-nav {
		position: relative;
		display: inline-flex;
	}

	.tl-nav__toggle {
		display: flex;
		align-items: center;
		gap: 7px;
		padding: 9px 12px;
		background: var(--bg);
		color: var(--fg-muted);
		border: var(--line) solid var(--border);
		border-radius: 0;
		font: 700 12px/1 var(--font-mono);
		letter-spacing: 0.12em;
		cursor: pointer;
		transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
	}

	.tl-nav__toggle:hover {
		background: var(--fg);
		color: var(--bg);
	}

	.tl-nav__toggle[aria-expanded='true'] {
		background: var(--accent);
		color: var(--bg);
		border-color: var(--accent);
	}

	.tl-nav__caret {
		font-size: 10px;
		line-height: 1;
		transition: transform 0.15s ease;
	}

	.tl-nav__toggle[aria-expanded='true'] .tl-nav__caret {
		transform: rotate(180deg);
	}

	/* ===== 下拉卡片 ===== */
	.tl-nav__panel {
		position: absolute;
		top: calc(100% + 6px);
		right: 0;
		width: 460px;
		max-width: calc(100vw - 32px); /* 窄屏兜底 */
		background: var(--bg);
		border: var(--line) solid var(--border);
		z-index: 80;
		padding: 18px 20px 20px;
	}

	.tl-nav__panel[hidden] {
		display: none;
	}

	.tl-nav__head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 12px;
		flex-wrap: wrap;
		margin-bottom: 14px;
	}

	.tl-nav__kicker {
		font-family: var(--font-mono);
		font-size: 12px;
		font-weight: 700;
		letter-spacing: 0.18em;
		color: var(--accent);
	}

	.tl-nav__hint {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.1em;
		color: var(--fg-muted);
	}

	/* 滑块 / 刻度 / 场景 */
	.tl-nav__range {
		-webkit-appearance: none;
		appearance: none;
		width: 100%;
		height: 2px;
		background: var(--grid-line);
		outline: none;
		cursor: pointer;
		display: block;
	}

	.tl-nav__range::-webkit-slider-thumb {
		-webkit-appearance: none;
		appearance: none;
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: var(--fg);
		border: 3px solid var(--bg);
		box-shadow: 0 0 0 2px var(--border);
		transition: background-color 0.15s ease;
	}

	.tl-nav__range:hover::-webkit-slider-thumb {
		background: var(--accent);
	}

	.tl-nav__range::-moz-range-thumb {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--fg);
		border: 3px solid var(--bg);
		box-shadow: 0 0 0 2px var(--border);
		transition: background-color 0.15s ease;
	}

	.tl-nav__range:hover::-moz-range-thumb {
		background: var(--accent);
	}

	.tl-nav__marks {
		position: relative;
		height: 14px;
		margin-top: 10px;
	}

	/* 刻度绝对定位：中心精确落在 thumb 可达等分点（thumb 半宽 10px） */
	.tl-nav__mark {
		position: absolute;
		top: 0;
		transform: translateX(-50%);
		white-space: nowrap;
		font-family: var(--font-mono);
		font-size: 10px;
		letter-spacing: 0.06em;
		color: var(--fg-muted);
		transition: color 0.15s ease;
	}

	.tl-nav__mark.is-active {
		color: var(--fg);
		font-weight: 700;
	}

	.tl-nav__scenes {
		margin-top: 16px;
		min-height: 48px;
	}

	.tl-nav__scene {
		display: none;
		padding: 14px 16px;
		background-color: var(--bg-alt);
		border-left: 3px solid var(--accent);
	}

	.tl-nav__scene.is-active {
		display: block;
		animation: tlNavFade 0.35s ease;
	}

	@keyframes tlNavFade {
		from { opacity: 0; transform: translateY(6px); }
		to { opacity: 1; transform: none; }
	}

	.tl-nav__title {
		margin: 0;
		font-size: 15px;
		font-weight: 800;
		letter-spacing: 0.02em;
	}

	/* ===== 移动端（汉堡菜单内实例） ===== */
	@media (max-width: 640px) {
		.tl-nav--mobile {
			display: block;
		}

		.tl-nav--mobile .tl-nav__toggle {
			width: 100%;
		}

		/* 面板改为静态全宽，随菜单内容自然展开，避免 460px 固定宽度溢出 */
		.tl-nav--mobile .tl-nav__panel {
			position: static;
			width: auto;
			max-width: none;
			margin-top: 8px;
		}
	}
</style>

---
import '../styles/global.css';
import MusicToggle from '../components/MusicToggle.astro';
import SocialDropdown from '../components/SocialDropdown.astro';
import SocialIcon from '../components/SocialIcon.astro';
import NavGroupDropdown from '../components/NavGroupDropdown.astro';
import TimelineNav from '../components/TimelineNav.astro';
import { getCollection } from 'astro:content';
import { config } from '../lib/config';
import { pairKeyOf } from '../lib/variants';

const { title = `${config.site.name} · 个人博客`, nav } = Astro.props as {
	title?: string;
	nav?: { label: string; href: string }[];
};

// 默认导航——仅当 config.mjs 未配置 [nav] 时使用
const defaultNav = [
	{ label: '首页', href: '/' },
	{ label: '归档', href: '/archive' },
	{ label: '关于', href: '/about' },
];

// 当前路径（导航高亮用，忽略尾斜杠差异）
const currentPath = Astro.url.pathname;
const normalize = (p: string) => p.replace(/\/+$/, '') || '/';
const isNavActive = (href: string) =>
	!href.startsWith('http') && normalize(href) === normalize(currentPath);

// 导航项优先级：页面显式 nav prop > config.mjs [nav] > 内置默认导航
const navItems =
	nav ??
	(config.nav.items.length > 0 ? config.nav.items : defaultNav);

// 主题配置（来自 config.mjs）
// 注意：不能直接注入 --accent（会污染古代主题的强调色），
// 而是注入 --modern-accent / --ancient-accent，由各主题变量组自行引用
const themeStyle = `--modern-accent: ${config.theme.accent}; --ancient-accent: ${config.theme.ancient_accent};`;
const textures = config.theme.enable_textures ? 'on' : 'off';

// 时间线索引：内容源 + slug → timeline 配置（guests / stories 各自配置）
const timelineIndex = new Map<string, any[]>();
for (const entry of await getCollection('guests')) {
	if (entry.data.timeline?.length) timelineIndex.set(`guests/${pairKeyOf(entry.id)}`, entry.data.timeline);
}
for (const entry of await getCollection('stories')) {
	if (entry.data.timeline?.length) timelineIndex.set(`stories/${pairKeyOf(entry.id)}`, entry.data.timeline);
}

// 当前页面匹配：/guests/xxx/ → guests/xxx；未匹配 → null（默认两节点）
const pathSegs = Astro.url.pathname.split('/').filter(Boolean);
const pageTimeline: any[] | null =
	pathSegs.length >= 2 ? (timelineIndex.get(`${pathSegs[0]}/${pathSegs[1]}`) ?? null) : null;

// 默认主题：当前页面时间线“现在”档的 theme，否则 config 默认
const eraDefaultTheme =
	pageTimeline && pageTimeline.length > 0
		? (pageTimeline[pageTimeline.length - 1]?.theme ?? config.theme.default)
		: config.theme.default;
---

<!doctype html>
<html
	lang="zh-CN"
	data-theme="modern"
	data-textures={textures}
	data-default-theme={eraDefaultTheme}
	style={themeStyle}
>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<!-- 首帧前恢复主题，避免闪烁（FOUC）；默认主题来自 config.mjs -->
		<script is:inline>
			(function () {
				// 主题由时间线驱动（data-default-theme 已注入默认档），不再使用 localStorage
				var theme =
					document.documentElement.getAttribute('data-default-theme') || 'modern';
				document.documentElement.setAttribute('data-theme', theme);
			})();
		</script>
		<!-- 黑幕（.spoiler）：点击切换显示（移动端无 hover，点击保持显示） -->
		<script is:inline>
			(function () {
				document.addEventListener('click', function (e) {
					var el = e.target && e.target.closest ? e.target.closest('.spoiler') : null;
					if (el) el.classList.toggle('revealed');
				});
			})();
		</script>
	</head>
	<body>
		<!-- ===== 顶栏 ===== -->
		<header class="topbar">
			<a class="brand" href="/">{config.site.name}</a>
			<div class="topbar__right">
				<nav class="nav" aria-label="站点导航">
					{
						navItems.map((item) => (
							<a
								href={item.href}
								class:list={[{ 'nav__link--active': isNavActive(item.href) }]}
								aria-current={isNavActive(item.href) ? 'page' : undefined}
							>
								{item.label}
							</a>
						))
					}
					{
						config.nav.groups.map((group) => (
							<NavGroupDropdown group={group} />
						))
					}
					<TimelineNav timeline={pageTimeline} />
				</nav>
				<SocialDropdown class="topbar__dropdown" links={config.social.links} />
				<button
					id="menu-toggle"
					class="menu-toggle"
					type="button"
					aria-expanded="false"
					aria-label="菜单"
				>
					<span class="menu-toggle__bar" aria-hidden="true"></span>
					<span class="menu-toggle__bar" aria-hidden="true"></span>
					<span class="menu-toggle__bar" aria-hidden="true"></span>
				</button>
			</div>

			<!-- 移动端菜单面板（<640px 显示） -->
			<div id="mobile-menu" class="mobile-menu" hidden>
				<nav class="mobile-menu__nav" aria-label="站点导航">
					{
						navItems.map((item) => (
							<a
								class:list={[
									'mobile-menu__link',
									{ 'mobile-menu__link--active': isNavActive(item.href) },
								]}
								href={item.href}
								aria-current={isNavActive(item.href) ? 'page' : undefined}
							>
								{item.label}
							</a>
						))
					}
				</nav>
				{/* 移动端时间线入口（桌面端在 .nav 内） */}
				<div class="mobile-menu__section">
					<p class="mobile-menu__label">时间线</p>
					<TimelineNav timeline={pageTimeline} variant="mobile" />
				</div>
				{
					config.nav.groups.map((group) => (
						<div class="mobile-menu__section">
							<p class="mobile-menu__label">{group.label}</p>
							<div class="mobile-menu__langs">
								{
									group.items.map((item) => (
										<a class="mobile-menu__lang" href={item.href}>
											{item.label}
										</a>
									))
								}
							</div>
						</div>
					))
				}
				{
					config.social.links.length > 0 && (
						<div class="mobile-menu__section">
							<p class="mobile-menu__label">社交</p>
							<div class="mobile-menu__langs">
								{
									config.social.links.map((l) => (
										<a
											class="mobile-menu__lang"
											href={l.href}
											target={l.href.startsWith('http') ? '_blank' : undefined}
											rel={l.href.startsWith('http') ? 'noopener noreferrer' : undefined}
										>
											<SocialIcon label={l.label} href={l.href} icon={l.icon} />
											{l.label}
										</a>
									))
								}
							</div>
						</div>
					)
				}
			</div>
		</header>

		<slot />

		<!-- ===== Footer ===== -->
		<footer class="footer">
			<div class="footer__row">
				<p>© {new Date().getFullYear()} {config.site.name} · 个人博客</p>
				<p class="footer__mono">
					纯 CSS 变量 · 零依赖 · <span id="footer-theme">现代</span>
				</p>
			</div>
		</footer>

		<!-- ===== 回到顶部 ===== -->
		<button
			id="back-to-top"
			class="back-to-top"
			type="button"
			aria-label="Back to top"
		>
			<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true">
				<path d="M8 13V3M3 8l5-5 5 5" />
			</svg>
		</button>

		<!-- ===== 全局音乐播放器 ===== -->
		<MusicToggle />
	</body>
</html>

<style>
	/* ===== 顶栏 ===== */
	.topbar {
		position: sticky;
		top: 0;
		z-index: 50;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 10px 16px;
		padding: 18px clamp(16px, 4vw, 48px);
		background: var(--bg);
		border-bottom: var(--line) solid var(--border);
		transition: background-color 0.25s ease;
	}

	.brand {
		font-size: 20px;
		font-weight: 900;
		letter-spacing: 0.08em;
		text-decoration: none;
		white-space: nowrap;
	}

	.brand sup {
		font-size: 10px;
		font-weight: 400;
		color: var(--accent);
	}

	.nav {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: clamp(12px, 2.5vw, 32px);
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.14em;
	}

	.nav > a {
		text-decoration: none;
		color: var(--fg-muted);
		transition: color 0.15s ease;
	}

	.nav > a:hover {
		color: var(--accent);
	}

	/* 当前页高亮：accent 色 + 下划线指示 */
	.nav > a.nav__link--active {
		color: var(--accent);
		position: relative;
	}

	.nav > a.nav__link--active::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		bottom: -6px;
		height: 2px;
		background: var(--accent);
	}

	.topbar__right {
		display: flex;
		align-items: center;
		gap: clamp(12px, 2vw, 24px);
	}

	/* ===== Footer ===== */
	.footer {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 18px;
		padding: 34px clamp(16px, 4vw, 48px);
		background: var(--fg);
		color: var(--bg);
		font-size: 13px;
	}

	.footer__row {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 10px;
		width: 100%;
	}

	.footer__mono {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.16em;
	}

	/* ===== 汉堡菜单（移动端） ===== */
	.menu-toggle {
		display: none;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 5px;
		width: 42px;
		height: 42px;
		background: var(--bg);
		color: var(--fg);
		border: var(--line) solid var(--border);
		border-radius: 0;
		cursor: pointer;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.menu-toggle:hover {
		background: var(--fg);
		color: var(--bg);
	}

	.menu-toggle[aria-expanded='true'] {
		background: var(--accent);
		color: var(--bg);
		border-color: var(--accent);
	}

	.menu-toggle__bar {
		width: 18px;
		height: 2px;
		background: currentColor;
		transition: transform 0.15s ease;
	}

	/* 展开时三线变 X */
	.menu-toggle[aria-expanded='true'] .menu-toggle__bar:nth-child(1) {
		transform: translateY(7px) rotate(45deg);
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle__bar:nth-child(2) {
		opacity: 0;
	}

	.menu-toggle[aria-expanded='true'] .menu-toggle__bar:nth-child(3) {
		transform: translateY(-7px) rotate(-45deg);
	}

	/* 移动菜单面板 */
	.mobile-menu {
		display: none;
		position: absolute;
		top: 100%;
		left: 0;
		right: 0;
		background: var(--bg);
		border-bottom: var(--line) solid var(--border);
		padding: 8px clamp(16px, 4vw, 48px) 24px;
		z-index: 60;
	}

	.mobile-menu__link {
		display: block;
		padding: 15px 0;
		font-size: 17px;
		font-weight: 700;
		text-decoration: none;
		border-bottom: 1px solid var(--grid-line);
		transition: color 0.15s ease;
	}

	.mobile-menu__link:hover {
		color: var(--accent);
	}

	.mobile-menu__link--active {
		color: var(--accent);
	}

	.mobile-menu__section {
		margin-top: 18px;
	}

	.mobile-menu__label {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.18em;
		color: var(--fg-muted);
		margin-bottom: 10px;
	}

	.mobile-menu__langs {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.mobile-menu__lang {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		border: 1px solid var(--grid-line);
		padding: 8px 14px;
		font-family: var(--font-mono);
		font-size: 12px;
		letter-spacing: 0.12em;
		text-decoration: none;
		color: var(--fg);
		transition: border-color 0.15s ease, color 0.15s ease;
	}

	.mobile-menu__lang:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.mobile-menu__lang--active {
		background: var(--accent);
		color: var(--bg);
		border-color: var(--accent);
		pointer-events: none;
	}

	/* ===== 响应式 ===== */
	@media (max-width: 640px) {
		.nav {
			display: none;
		}

		/* 社交下拉移入汉堡面板，顶栏隐藏 */
		.topbar__dropdown {
			display: none;
		}

		.menu-toggle {
			display: flex;
		}

		.mobile-menu:not([hidden]) {
			display: block;
		}
	}
</style>

<script>
	// 移动端汉堡菜单
	const menuToggle = document.getElementById('menu-toggle');
	const mobileMenu = document.getElementById('mobile-menu');

	if (menuToggle && mobileMenu) {
		const closeMenu = () => {
			mobileMenu.hidden = true;
			menuToggle.setAttribute('aria-expanded', 'false');
		};

		menuToggle.addEventListener('click', (e) => {
			e.stopPropagation();
			mobileMenu.hidden = !mobileMenu.hidden;
			menuToggle.setAttribute('aria-expanded', String(!mobileMenu.hidden));
		});

		// 捕获阶段：点击面板外部任意处关闭
		document.addEventListener(
			'click',
			(e) => {
				if (
					!mobileMenu.hidden &&
					(!(e.target instanceof Node) || !mobileMenu.contains(e.target)) &&
					e.target !== menuToggle
				) {
					closeMenu();
				}
			},
			true
		);

		document.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && !mobileMenu.hidden) {
				closeMenu();
				menuToggle.focus();
			}
		});

		// 点击面板内任意链接后关闭
		mobileMenu.addEventListener('click', (e) => {
			if (e.target instanceof Element && e.target.closest('a')) closeMenu();
		});
	}

	// ===== 回到顶部 =====
	const backToTop = document.getElementById('back-to-top');
	if (backToTop) {
		const SHOW_AFTER = 600;
		let ticking = false;

		const update = () => {
			backToTop.classList.toggle('is-visible', window.scrollY > SHOW_AFTER);
			ticking = false;
		};

		window.addEventListener(
			'scroll',
			() => {
				if (!ticking) {
					ticking = true;
					requestAnimationFrame(update);
				}
			},
			{ passive: true }
		);

		backToTop.addEventListener('click', () => {
			window.scrollTo({ top: 0, behavior: 'smooth' });
		});

		update();
	}
</script>

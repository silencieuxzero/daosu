---
// 文章详情
import Layout from '../../layouts/Layout.astro';
import PostPage from '../../components/PostPage.astro';
import { getCollection } from 'astro:content';
import { pairEntries, entryFor } from '../../lib/variants';

import { config } from '../../lib/config';
export async function getStaticPaths() {
	const all = await getCollection('blog');
	// 配对键 → 两套变体（可能缺省）；URL 用配对键（剥离 .ancient）
	return pairEntries(all).map((pair) => ({
		params: { slug: pair.key },
		props: { pair },
	}));
}

const { pair } = Astro.props;

// 现代版优先用于 <title> 与导航（pair 至少含一个变体，此处非空断言）
const post = (entryFor(pair, 'modern') ?? entryFor(pair, 'ancient'))!;
const ancient = pair.ancient ?? null;
---

<Layout title={`${post.data.title} · ${config.site.name}`}>
	<PostPage post={post} ancient={ancient} />
</Layout>

---
import Layout from '../layouts/Layout.astro';
import { config } from '../lib/config';
import { getCollection } from 'astro:content';

// 茶客索引：来自 src/content/guests/*.md（+ .ancient 古代版），按 order 排序
// 主题分套：现代/古代各一套卡片，切换主题即时显隐
import { statusTextStyle } from '../lib/status';
import { pairEntries, entryFor, pairKeyOf, isDefined } from '../lib/variants';

const guests = pairEntries(await getCollection('guests'));
const hasAncient = guests.some((g) => g.ancient);

// 两套列表（古代缺省回退现代版）
const modernList = guests.map((p) => entryFor(p, 'modern')).filter(isDefined);
const ancientList = guests.map((p) => entryFor(p, 'ancient')).filter(isDefined);

// 隐藏茶客（谜题彩蛋）：未解锁时列表只显示占位卡，解锁后显示真实档案
const hiddenCount = modernList.filter((g) => g.data.hidden).length;
---

<Layout title={`茶客设定 · ${config.site.name}`}>
	<main class="page">
		<header class="sec-head">
			<span class="seal" aria-hidden="true">客</span>
			<p class="kicker">茶客设定 · 2026</p>
			<h1>茶客设定</h1>
			<p class="sec-head__desc">
				出入茶馆的茶客们——他们的名字、来历与随身之物。已登记
				<span data-role="guest-count" data-total={guests.length}>{guests.length - hiddenCount}</span> 位，点击卡片查看档案。
			</p>
		</header>

		<!-- 回纹条带（仅古代主题） -->
		<div class="band" aria-hidden="true"></div>

		<!-- ===== 茶客卡片网格（现代主题；无古代版时两主题共用，不附加 data-split） ===== -->
		<div data-split={hasAncient ? 'modern' : undefined}>
			<section class="guest-grid" aria-label="茶客列表">
				{
					modernList.map((guest, i) =>
						guest.data.hidden ? (
							<>
								{/* 未解锁：占位卡（点击去谜题间） */}
								<article class="guest-card guest-card--locked" data-locked-placeholder>
									<a class="guest-card__link" href="/puzzle-room/">
										<div class="guest-card__img">
											<span class="guest-card__placeholder">？</span>
										</div>
										<div class="guest-card__body">
											<p class="guest-card__idx">NO.{String(i + 1).padStart(2, '0')}</p>
											<h2 class="guest-card__name">？？？</h2>
											<p class="guest-card__desc">尚未遇见。集齐地下室的口令后，Ta 会出现在这里。</p>
											<p class="guest-card__meta">？？？ · ？？？</p>
										</div>
									</a>
								</article>
								{/* 已解锁：真实档案卡 */}
								<article class="guest-card" data-locked-guest hidden>
									<a class="guest-card__link" href={`/guests/${pairKeyOf(guest.id)}/`}>
										<div class="guest-card__img">
											{
												guest.data.portrait ? (
													<img
														src={guest.data.portrait}
														alt={`${guest.data.name}的立绘`}
														loading="lazy"
													/>
												) : (
													<span class="guest-card__placeholder" aria-hidden="true">
														{guest.data.name.charAt(0)}
													</span>
												)
											}
										</div>
										<div class="guest-card__body">
											<p class="guest-card__idx">NO.{String(i + 1).padStart(2, '0')}</p>
											<h2 class="guest-card__name">{guest.data.name}</h2>
											{
												guest.data.description && (
													<p class="guest-card__desc">{guest.data.description}</p>
												)
											}
											<p class="guest-card__meta">
												{guest.data.identity} ·{' '}
												<span
													class="guest-card__status"
													data-status={guest.data.status}
													style={statusTextStyle(String(guest.data.status ?? ''))}
												>
													{guest.data.status}
												</span>
											</p>
										</div>
									</a>
								</article>
							</>
						) : (
							<article class="guest-card">
								<a class="guest-card__link" href={`/guests/${pairKeyOf(guest.id)}/`}>
									<div class="guest-card__img">
										{
											guest.data.portrait ? (
												<img
													src={guest.data.portrait}
													alt={`${guest.data.name}的立绘`}
													loading="lazy"
												/>
											) : (
												<span class="guest-card__placeholder" aria-hidden="true">
													{guest.data.name.charAt(0)}
												</span>
											)
										}
									</div>
									<div class="guest-card__body">
										<p class="guest-card__idx">NO.{String(i + 1).padStart(2, '0')}</p>
										<h2 class="guest-card__name">{guest.data.name}</h2>
										{
											guest.data.description && (
												<p class="guest-card__desc">{guest.data.description}</p>
											)
										}
										<p class="guest-card__meta">
											{guest.data.identity} ·{' '}
											<span
												class="guest-card__status"
												data-status={guest.data.status}
												style={statusTextStyle(String(guest.data.status ?? ''))}
											>
												{guest.data.status}
											</span>
										</p>
									</div>
								</a>
							</article>
						)
					)
				}
			</section>
		</div>

		<!-- ===== 茶客卡片网格（古代主题，无 .ancient 变体时回退共用现代版） ===== -->
		{hasAncient && (
			<div data-split="ancient">
				<section class="guest-grid" aria-label="茶客列表">
					{
						ancientList.map((guest, i) =>
							guest.data.hidden ? (
								<>
									<article class="guest-card guest-card--locked" data-locked-placeholder>
										<a class="guest-card__link" href="/puzzle-room/">
											<div class="guest-card__img">
												<span class="guest-card__placeholder">？</span>
											</div>
											<div class="guest-card__body">
												<p class="guest-card__idx">NO.{String(i + 1).padStart(2, '0')}</p>
												<h2 class="guest-card__name">？？？</h2>
												<p class="guest-card__desc">尚未遇见。集齐地下室的口令后，Ta 会出现在这里。</p>
												<p class="guest-card__meta">？？？ · ？？？</p>
											</div>
										</a>
									</article>
									<article class="guest-card" data-locked-guest hidden>
										<a class="guest-card__link" href={`/guests/${pairKeyOf(guest.id)}/`}>
											<div class="guest-card__img">
												{
													guest.data.portrait ? (
														<img
															src={guest.data.portrait}
															alt={`${guest.data.name}的立绘`}
															loading="lazy"
														/>
													) : (
														<span class="guest-card__placeholder" aria-hidden="true">
															{guest.data.name.charAt(0)}
														</span>
													)
												}
											</div>
											<div class="guest-card__body">
												<p class="guest-card__idx">NO.{String(i + 1).padStart(2, '0')}</p>
												<h2 class="guest-card__name">{guest.data.name}</h2>
												{
													guest.data.description && (
														<p class="guest-card__desc">{guest.data.description}</p>
													)
												}
												<p class="guest-card__meta">
													{guest.data.identity} ·{' '}
													<span
														class="guest-card__status"
														data-status={guest.data.status}
														style={statusTextStyle(String(guest.data.status ?? ''))}
													>
														{guest.data.status}
													</span>
												</p>
											</div>
										</a>
									</article>
								</>
							) : (
								<article class="guest-card">
									<a class="guest-card__link" href={`/guests/${pairKeyOf(guest.id)}/`}>
										<div class="guest-card__img">
											{
												guest.data.portrait ? (
													<img
														src={guest.data.portrait}
														alt={`${guest.data.name}的立绘`}
														loading="lazy"
													/>
												) : (
													<span class="guest-card__placeholder" aria-hidden="true">
														{guest.data.name.charAt(0)}
													</span>
												)
											}
										</div>
										<div class="guest-card__body">
											<p class="guest-card__idx">NO.{String(i + 1).padStart(2, '0')}</p>
											<h2 class="guest-card__name">{guest.data.name}</h2>
											{
												guest.data.description && (
													<p class="guest-card__desc">{guest.data.description}</p>
												)
											}
											<p class="guest-card__meta">
												{guest.data.identity} ·{' '}
												<span
													class="guest-card__status"
													data-status={guest.data.status}
													style={statusTextStyle(String(guest.data.status ?? ''))}
												>
													{guest.data.status}
												</span>
											</p>
										</div>
									</a>
								</article>
							)
						)
					}
				</section>
			</div>
		)}
	</main>
</Layout>

<style>
	.page {
		padding: clamp(40px, 6vh, 72px) clamp(16px, 4vw, 48px);
		max-width: 860px;
		margin: 0 auto;
	}

	.sec-head {
		position: relative;
		padding-bottom: 26px;
		border-bottom: var(--line) solid var(--border);
		background-color: var(--bg);
		background-image: var(--texture-rect);
		background-size: 56px 56px;
	}

	.sec-head h1 {
		margin: 16px 0 14px;
		font-size: clamp(32px, 6vw, 56px);
		font-weight: 900;
		line-height: 1.05;
		letter-spacing: -0.02em;
	}

	.sec-head__desc {
		max-width: 52ch;
		font-size: clamp(14px, 1.5vw, 17px);
		line-height: 1.8;
		color: var(--fg-muted);
	}

	.sec-head > *:not(.seal) {
		position: relative;
		z-index: 1;
	}

	.band {
		display: none;
		height: 14px;
		background: var(--texture-band) repeat-x;
		background-size: 96px 14px;
		border-bottom: var(--line) solid var(--border);
	}

	[data-theme='ancient'] .band {
		display: block;
	}

	/* ===== 茶客卡片网格 ===== */
	.guest-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 18px;
		margin-top: clamp(40px, 6vh, 72px);
	}

	.guest-card {
		border: var(--line) solid var(--border);
		background-color: var(--bg);
		background-image: var(--texture-rect);
		background-size: 56px 56px;
		transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
	}

	.guest-card:hover,
	.guest-card:focus-within {
		border-color: var(--accent);
		box-shadow: 6px 6px 0 0 var(--accent);
		transform: translate(-2px, -2px);
	}

	/* 未解锁的隐藏茶客：虚线框占位卡 */
	.guest-card--locked {
		border-style: dashed;
	}

	.guest-card--locked .guest-card__idx {
		color: var(--fg-muted);
	}

	.guest-card--locked:hover,
	.guest-card--locked:focus-within {
		border-color: var(--fg-muted);
		box-shadow: 6px 6px 0 0 var(--fg-muted);
	}

	.guest-card__link {
		display: flex;
		flex-direction: column;
		height: 100%;
		text-decoration: none;
		color: inherit;
	}

	.guest-card__img {
		aspect-ratio: 3 / 4;
		overflow: hidden;
		border-bottom: var(--line) solid var(--border);
		background: var(--bg-alt);
	}

	.guest-card__img img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.3s ease;
	}

	.guest-card__placeholder {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 100%;
		height: 100%;
		background-color: var(--bg);
		background-image: var(--texture-rect);
		background-size: 56px 56px;
		font-family: 'STKaiti', 'KaiTi', 'SimSun', 'Noto Serif SC', serif;
		font-size: clamp(56px, 9vw, 84px);
		font-weight: 700;
		color: var(--accent);
	}

	.guest-card:hover .guest-card__img img,
	.guest-card:focus-within .guest-card__img img {
		transform: scale(1.04);
	}

	.guest-card__body {
		padding: 16px 18px 18px;
		display: flex;
		flex-direction: column;
		gap: 8px;
		flex: 1;
	}

	.guest-card__idx {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.16em;
		color: var(--accent);
	}

	.guest-card__name {
		font-size: clamp(17px, 2vw, 21px);
		font-weight: 900;
		line-height: 1.3;
	}

	.guest-card__desc {
		flex: 1;
		font-size: 13px;
		line-height: 1.7;
		color: var(--fg-muted);
	}

	.guest-card__meta {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.12em;
		color: var(--fg-muted);
	}

	/* 古代主题：器物式双线层叠 */
	[data-theme='ancient'] .guest-card {
		outline: 2px solid var(--grid-line);
		outline-offset: 4px;
	}
</style>

<script>
	// 隐藏茶客（谜题彩蛋）：地下室解锁（daosu.puzzle.basement.v2）后显示真实档案
	import { storageKey, loadFlag } from '../lib/puzzle';

	const open = loadFlag(storageKey('basement'));
	document.querySelectorAll<HTMLElement>('[data-locked-guest]').forEach((el) => {
		el.hidden = !open;
	});
	document.querySelectorAll<HTMLElement>('[data-locked-placeholder]').forEach((el) => {
		el.hidden = open;
	});
	const countEl = document.querySelector<HTMLElement>('[data-role="guest-count"]');
	if (countEl && open) {
		countEl.textContent = String(countEl.dataset.total ?? '');
	}
</script>

---
// 茶客详情页（内容集合驱动）：/guests/xxx/
// 主题分套：同一 URL 下渲染现代/古代两套档案，切换主题即时显隐
import Layout from '../../layouts/Layout.astro';
import GuestProfile from '../../components/GuestProfile.astro';
import { config } from '../../lib/config';
import { getCollection, render } from 'astro:content';
import { pairEntries, entryFor } from '../../lib/variants';

export async function getStaticPaths() {
	const all = await getCollection('guests');
	// 配对键 → 两套变体（可能缺省）；URL 用配对键（剥离 .ancient）
	return pairEntries(all).map((pair) => ({
		params: { slug: pair.key },
		props: { pair },
	}));
}

const { pair } = Astro.props;

// 现代版优先用于 <title> 与导航（pair 至少含一个变体，此处非空断言）
const primary = (entryFor(pair, 'modern') ?? entryFor(pair, 'ancient'))!;
const modernGuest: any = pair.modern ?? null;
const ancientGuest: any = pair.ancient ?? null;
const hasAncient = Boolean(ancientGuest);

const modern = modernGuest ? (await render(modernGuest)).Content : null;
const ancient = ancientGuest ? (await render(ancientGuest)).Content : null;

// 上一篇 / 下一篇（按 order 排序的配对列表）
const all = pairEntries(await getCollection('guests'));
const idx = all.findIndex((p) => p.key === pair.key);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : null;
const navName = (p: any) => p.modern?.data.name ?? p.ancient?.data.name ?? '';
---

<Layout title={`${primary.data.name} · 茶客设定 · ${config.site.name}`}>
	<main class="page">
		<p class="back">
			<a class="btn btn--outline" href="/guests/">
				← 返回茶客设定
			</a>
		</p>

		<!-- ===== 现代主题档案（无古代版时两主题共用，不附加 data-split） ===== -->
		{modern && (
			<div data-split={hasAncient ? 'modern' : undefined}>
				<GuestProfile guest={modernGuest} Content={modern} />
			</div>
		)}

		<!-- ===== 古代主题档案（无现代版时两主题共用，不附加 data-split） ===== -->
		{hasAncient && (
			<div data-split={modern ? 'ancient' : undefined}>
				<GuestProfile guest={ancientGuest} Content={ancient} />
			</div>
		)}

		<!-- ===== 其他茶客 ===== -->
		{
			(prev || next) && (
				<nav class="guest-nav" aria-label="其他茶客">
					{
						prev ? (
							<a class="guest-nav__item" href={`/guests/${prev.key}/`}>
								<span class="guest-nav__dir">← 上一位</span>
								<span class="guest-nav__name">{navName(prev)}</span>
							</a>
						) : (
							<span></span>
						)
					}
					{
						next ? (
							<a class="guest-nav__item guest-nav__item--next" href={`/guests/${next.key}/`}>
								<span class="guest-nav__dir">下一位 →</span>
								<span class="guest-nav__name">{navName(next)}</span>
							</a>
						) : (
							<span></span>
						)
					}
				</nav>
			)
		}
	</main>
</Layout>

<style>
	.page {
		padding: clamp(40px, 6vh, 72px) clamp(16px, 4vw, 48px);
		max-width: 820px;
		margin: 0 auto;
	}

	.back {
		margin-bottom: clamp(24px, 3vh, 36px);
	}

	/* ===== 其他茶客导航 ===== */
	.guest-nav {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		margin-top: clamp(44px, 6vh, 64px);
		padding-top: 24px;
		border-top: var(--line) solid var(--border);
	}

	.guest-nav__item {
		display: flex;
		flex-direction: column;
		gap: 6px;
		text-decoration: none;
		padding: 14px 18px;
		border: var(--line) solid var(--border);
		transition: background-color 0.15s ease, color 0.15s ease, border-color 0.15s ease;
	}

	.guest-nav__item--next {
		align-items: flex-end;
		text-align: right;
	}

	.guest-nav__item:hover {
		background: var(--fg);
		color: var(--bg);
		border-color: var(--border);
	}

	.guest-nav__dir {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.14em;
		color: var(--fg-muted);
		transition: color 0.15s ease;
	}

	.guest-nav__item:hover .guest-nav__dir {
		color: var(--accent);
	}

	.guest-nav__name {
		font-size: 15px;
		font-weight: 800;
	}
</style>

---
// 多媒体库（原画廊内容）：几何纹样网格 + lightbox
// 主题分套：现代/古代各一套图集（config.mjs [gallery.modern|ancient]）
import Layout from '../layouts/Layout.astro';
import GalleryGrid from '../components/GalleryGrid.astro';
import { config } from '../lib/config';
---

<Layout title={`多媒体库 · ${config.site.name}`}>
	<!-- ===== 现代主题图集 ===== -->
	<GalleryGrid
		locale="zh"
		split="modern"
		images={config.gallery.modern}
		head={{
			kicker: '多媒体库 · 2026',
			title: '多媒体库',
			desc: '音乐、图像与影像的陈列架。收藏与创作都在这里。',
		}}
	/>

	<!-- ===== 古代主题图集（bare：不重复渲染头部） ===== -->
	<GalleryGrid
		locale="zh"
		split="ancient"
		images={config.gallery.ancient}
		bare
	/>
</Layout>

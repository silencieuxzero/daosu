---
// 茶馆故事详情页（内容集合驱动）：/stories/xxx/
// 主题分套：同一 URL 下渲染现代/古代两套故事，切换主题即时显隐
import Layout from '../../layouts/Layout.astro';
import { config } from '../../lib/config';
import { getCollection, render } from 'astro:content';
import { formatDate } from '../../lib/date';
import { pairEntries, entryFor, pairKeyOf } from '../../lib/variants';
import { getEntry } from 'astro:content';

export async function getStaticPaths() {
	const all = await getCollection('stories');
	// 配对键 → 两套变体（可能缺省）；URL 用配对键（剥离 .ancient）
	return pairEntries(all).map((pair) => ({
		params: { slug: pair.key },
		props: { pair },
	}));
}

const { pair } = Astro.props;

// 现代版优先用于 <title> 与导航（pair 至少含一个变体，此处非空断言）
const primary = (entryFor(pair, 'modern') ?? entryFor(pair, 'ancient'))!;
const modernStory: any = pair.modern ?? null;
const ancientStory: any = pair.ancient ?? null;
const hasAncient = Boolean(ancientStory);

// 注意：模板中直接渲染的组件变量必须以大写开头，否则会被当作 HTML 元素
const ModernContent: any = modernStory ? (await render(modernStory)).Content : null;
const AncientContent: any = ancientStory ? (await render(ancientStory)).Content : null;

// 上一篇 / 下一篇（按 order 排序的配对列表）
const all = pairEntries(await getCollection('stories'));
const idx = all.findIndex((p) => p.key === pair.key);
const prev = idx > 0 ? all[idx - 1] : null;
const next = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : null;
const navName = (p: any) => p.modern?.data.title ?? p.ancient?.data.title ?? '';

const fmt = (d?: Date) => (d ? formatDate(d) : '');

// 时间线 era 分块：正文从 src/content/timelines/stories/<slug>/<era>.md 加载
const storySlug = modernStory ? pairKeyOf(modernStory.id) : '';
const hasTimeline = (modernStory?.data.timeline?.length ?? 0) > 0;
let storyEraBlocks: { era: number; title: string; Content: any }[] = [];
if (hasTimeline && storySlug) {
	storyEraBlocks = await Promise.all(
		modernStory.data.timeline.map(async (it: any) => {
			const entry = await getEntry('timelines', `stories/${storySlug}/${it.era}`);
			const rendered = entry ? await render(entry) : null;
			return { era: it.era, title: it.title, Content: rendered?.Content ?? null };
		})
	);
}
---

<Layout title={`${primary.data.title} · 茶馆故事 · ${config.site.name}`}>
	<main class="page">
		<p class="back">
			<a class="btn btn--outline" href="/stories/">
				← 返回茶馆故事
			</a>
		</p>

		<!-- ===== 现代主题故事（无古代版时两主题共用，不附加 data-split） ===== -->
		{ModernContent && (
			<div data-split={AncientContent ? 'modern' : undefined}>
				<article class="prose">
					<header class="story-head">
						<span class="seal" aria-hidden="true">故</span>
						<p class="kicker">
							{modernStory.data.author && <span>{modernStory.data.author}</span>}
							{modernStory.data.date && <span> · {fmt(modernStory.data.date)}</span>}
						</p>
						<h1>{modernStory.data.title}</h1>
						{modernStory.data.description && (
							<p class="story-head__desc">{modernStory.data.description}</p>
						)}
						{modernStory.data.tags.length > 0 && (
							<div class="story-head__tags">
								{modernStory.data.tags.map((tag: string) => (
									<span class="story-head__tag">{tag}</span>
								))}
							</div>
						)}
					</header>
					{hasTimeline && (
						<>
							{storyEraBlocks.map((e) => (
								<div data-era-block={e.era}>
									<h2 class="story-era__title">{e.title}</h2>
									{e.Content ? <e.Content /> : <p>该时期的内容尚未撰写。</p>}
								</div>
							))}
							<div data-era-block="full">
								<ModernContent />
							</div>
						</>
					)}
					{!hasTimeline && <ModernContent />}
				</article>
				{modernStory.data.source && (
					<p class="story__source">
						故事来源：{modernStory.data.source} · CC-BY-SA
					</p>
				)}
			</div>
		)}

		<!-- ===== 古代主题故事（无现代版时两主题共用，不附加 data-split） ===== -->
		{hasAncient && (
			<div data-split={ModernContent ? 'ancient' : undefined}>
				<article class="prose">
					<header class="story-head">
						<span class="seal" aria-hidden="true">故</span>
						<p class="kicker">
							{ancientStory.data.author && <span>{ancientStory.data.author}</span>}
							{ancientStory.data.date && <span> · {fmt(ancientStory.data.date)}</span>}
						</p>
						<h1>{ancientStory.data.title}</h1>
						{ancientStory.data.description && (
							<p class="story-head__desc">{ancientStory.data.description}</p>
						)}
						{ancientStory.data.tags.length > 0 && (
							<div class="story-head__tags">
								{ancientStory.data.tags.map((tag: string) => (
									<span class="story-head__tag">{tag}</span>
								))}
							</div>
						)}
					</header>
					<AncientContent />
				</article>
				{ancientStory.data.source && (
					<p class="story__source">
						故事来源：{ancientStory.data.source} · CC-BY-SA
					</p>
				)}
			</div>
		)}

		<!-- ===== 其他故事 ===== -->
		{
			(prev || next) && (
				<nav class="story-nav" aria-label="其他故事">
					{
						prev ? (
							<a class="story-nav__item" href={`/stories/${prev.key}/`}>
								<span class="story-nav__dir">← 上一篇</span>
								<span class="story-nav__name">{navName(prev)}</span>
							</a>
						) : (
							<span></span>
						)
					}
					{
						next ? (
							<a class="story-nav__item story-nav__item--next" href={`/stories/${next.key}/`}>
								<span class="story-nav__dir">下一篇 →</span>
								<span class="story-nav__name">{navName(next)}</span>
							</a>
						) : (
							<span></span>
						)
					}
				</nav>
			)
		}
	</main>
</Layout>

<style>
	.page {
		padding: clamp(40px, 6vh, 72px) clamp(16px, 4vw, 48px);
		max-width: 760px;
		margin: 0 auto;
	}

	.back {
		margin-bottom: clamp(24px, 3vh, 36px);
	}

	/* ===== 时间线 era 分块标题 ===== */
	.story-era__title {
		margin: 0 0 16px;
		padding-bottom: 10px;
		font-size: 18px;
		font-weight: 800;
		letter-spacing: 0.04em;
		border-bottom: var(--line) solid var(--border);
	}

	/* ===== 故事头部 ===== */
	.story-head {
		position: relative;
		padding-bottom: 26px;
		margin-bottom: 28px;
		border-bottom: var(--line) solid var(--border);
		background-color: var(--bg);
		background-image: var(--texture-rect);
		background-size: 56px 56px;
	}

	.story-head h1 {
		margin: 16px 0 14px;
		font-size: clamp(28px, 4.5vw, 40px);
		font-weight: 900;
		line-height: 1.25;
		letter-spacing: -0.01em;
	}

	.story-head__desc {
		color: var(--fg-muted);
		line-height: 1.8;
		margin-bottom: 16px;
	}

	.story-head__tags {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.story-head__tag {
		border: 1px solid var(--grid-line);
		padding: 4px 10px;
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.12em;
		color: var(--fg-muted);
	}

	/* 铭文水印 */
	.story-head .seal {
		right: 0;
		top: -10px;
		font-size: clamp(90px, 16vw, 200px);
	}

	.story-head > *:not(.seal) {
		position: relative;
		z-index: 1;
	}

	/* 故事正文中的分隔线用细横线 */
	.story__source {
		margin-top: 32px;
		padding-top: 14px;
		border-top: 1px solid var(--grid-line);
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.1em;
		color: var(--fg-muted);
	}

	/* ===== 其他故事导航 ===== */
	.story-nav {
		display: flex;
		justify-content: space-between;
		gap: 16px;
		margin-top: clamp(44px, 6vh, 64px);
		padding-top: 24px;
		border-top: var(--line) solid var(--border);
	}

	.story-nav__item {
		display: flex;
		flex-direction: column;
		gap: 6px;
		text-decoration: none;
		padding: 14px 18px;
		border: var(--line) solid var(--border);
		max-width: 46%;
		transition: background-color 0.15s ease, color 0.15s ease;
	}

	.story-nav__item--next {
		align-items: flex-end;
		text-align: right;
	}

	.story-nav__item:hover {
		background: var(--fg);
		color: var(--bg);
	}

	.story-nav__dir {
		font-family: var(--font-mono);
		font-size: 11px;
		letter-spacing: 0.14em;
		color: var(--fg-muted);
		transition: color 0.15s ease;
	}

	.story-nav__item:hover .story-nav__dir {
		color: var(--accent);
	}

	.story-nav__name {
		font-size: 15px;
		font-weight: 800;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
</style>
